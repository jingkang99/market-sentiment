{
  "name": "market-sentiment",
  "version": "1.0.0",
  "private": true,
  "description": "SPY & QQQ market sentiment dashboard (local Node backend + React)",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "esbuild app.jsx --bundle --minify --outfile=public/app.js --format=iife --platform=browser --target=es2019 --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\"",
    "watch": "esbuild app.jsx --bundle --sourcemap --outfile=public/app.js --watch",
    "package": "npm run build && pkg . --out-path dist"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "express": "^4.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
